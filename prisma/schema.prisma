generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SelectedCard {
  id            String      @id @default(uuid())
  code          String
  image         String
  round         Int
  gameDetailsId String
  gameDetails   GameDetails @relation(fields: [gameDetailsId], references: [id])
}

model SeasonDetails {
  id     String @id @default(uuid())
  season String
  week   String
}

model Guess {
  id        String  @id @default(uuid())
  season    Int
  week      Int
  autoGuess Boolean
  playerId  String
  username  String
  round     Int
  code      String
}

model GameDetails {
  id                String         @id @default(uuid())
  season            Int            @default(1)
  week              Int            @default(1)
  guessLockTime     DateTime
  isCheckingGuesses Boolean        @default(false)
  currentRound      Int?
  selectedCards     SelectedCard[]
}

model Countdown {
  id           String   @id @default(uuid())
  nextGameDate DateTime
}

model CorrectGuess {
  id       String @id @default(uuid())
  season   Int
  week     Int
  round    Int
  points   Int
  code     String
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
}

model Player {
  id             String         @id @default(uuid())
  username       String
  password       String
  email          String
  correctGuesses CorrectGuess[]
}
